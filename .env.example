# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# SMTP credentials used by nodemailer to send contact/review emails.
# For Gmail: use a 16-character App Password, not your normal password
# (requires 2-Step Verification enabled on the Google account).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=chidera9713@gmail.com
SMTP_PASS=

# Optional overrides — default to SMTP_USER / the owner's inbox if unset.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Optional. In E.164 format, e.g. +2348012345678.
# Phone/WhatsApp contact tiles on /contact only render when this is set.
CONTACT_PHONE_NUMBER=
